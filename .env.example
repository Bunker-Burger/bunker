# Public Supabase configuration (publishable key only, never the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Which cloud project the credentials above belong to: "development" or "production".
# Only the Vercel production deployment may use "production"; local, CI and previews use "development".
SUPABASE_PROJECT_ENV=development
# Production project ref; when set, non-production runs refuse credentials that point at it.
SUPABASE_PRODUCTION_PROJECT_REF=

# Type generation source for `pnpm run db:types` (development project only)
SUPABASE_DEV_PROJECT_REF=

# Optional test accounts in the DEVELOPMENT project for `pnpm run test:integration`
# (an active admin of bunker-burger and a signed-in user without membership)
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
SUPABASE_TEST_MEMBERLESS_EMAIL=
SUPABASE_TEST_MEMBERLESS_PASSWORD=

# Server-only Supabase service role: durable payment quotes and attempts (Mercado Pago)
SUPABASE_SERVICE_ROLE_KEY=

# Optional Mercado Pago Checkout Pro. The storefront offers it only when a checkout can start:
# access token + valid http(s) APP_URL + store method enabled + SUPABASE_SERVICE_ROLE_KEY and,
# in production, the distributed quota service below. Otherwise it is hidden (the API answers 503).
# Public Key and Webhook Secret are not needed to create preferences (webhooks arrive with BB-15).
MERCADO_PAGO_ACCESS_TOKEN=
# Public base URL for Mercado Pago return URLs (falls back to https://$VERCEL_URL)
APP_URL=http://localhost:3000

# Distributed checkout quota (10/min/IP). Required in production: without it Mercado Pago is hidden
# and its API fails closed. Development uses an in-process store.
RATE_LIMIT_UPSTREAM_URL=
RATE_LIMIT_API_KEY=

