# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase access for trusted payment/webhook operations
SUPABASE_SECRET_KEY=

# Optional Mercado Pago Checkout Pro (leave every value empty to hide it)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Public canonical URL used in callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

