# Public Supabase configuration (publishable key only, never the secret key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Which cloud project the credentials above belong to: "development" or "production".
# Only the Vercel production deployment may use "production"; local, CI and previews use "development".
SUPABASE_PROJECT_ENV=development
# Production project ref; when set, non-production runs refuse credentials that point at it.
SUPABASE_PRODUCTION_PROJECT_REF=

# Type generation source for `npm run db:types` (development project only)
SUPABASE_DEV_PROJECT_REF=

# Server-only Supabase access for trusted payment/webhook operations
SUPABASE_SECRET_KEY=

# Optional Mercado Pago Checkout Pro (leave every value empty to hide it)
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Public canonical URL used in callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

