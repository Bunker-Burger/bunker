{
  "name": "bunker-burger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run src/server/catalog/supabase-catalog-repository.integration.test.ts src/server/auth/admin-session.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:admin-auth": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test --config=playwright.admin-auth.config.ts",
    "db:push": "supabase db push --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:diff": "supabase db diff --linked",
    "db:test": "supabase test db --linked",
    "db:types": "node --env-file-if-exists=.env.local scripts/generate-db-types.mjs",
    "db:types:check": "node --env-file-if-exists=.env.local scripts/generate-db-types.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@serwist/next": "9.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.552.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "serwist": "9.5.13",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.37.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "27.0.0",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
